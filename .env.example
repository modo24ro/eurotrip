# Cheie secretă pentru sesiunile Flask (schimbă cu un șir secret lung și aleator în producție)
FLASK_SECRET_KEY=change-me-to-a-very-secure-random-string

# Portul pe care va asculta aplicația pe mașina gazdă (implicit 5000)
PORT=5000

# Activare SSL auto-semnat în container (0 = dezactivat, 1 = activat)
USE_SSL=0
